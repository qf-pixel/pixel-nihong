# ============================================================
# 霓虹像素夜校 · 配置模板
# 用法：复制本文件为 application.properties，再填写自己的 MySQL 信息。
# 注意：application.properties 含真实密码，已被 .gitignore 排除，不要提交到仓库。
# ============================================================

# 监听所有网卡，允许局域网其他电脑访问
server.address=0.0.0.0
server.port=8080

# 统一 UTF-8，避免中文乱码
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.force=true

spring.application.name=kids-math-practice

# ============================================================
# MySQL 连接：请改成你本机/数据库服务器的信息
# ============================================================
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/kids_math?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
spring.datasource.username=root
# 把 CHANGE_ME 改成你的 MySQL root 密码；密码为空时留空等号右边
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# 连接池：小规模演示够用
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.connection-timeout=5000

# ============================================================
# 数据库初始化：表结构由 database/init.sql 手工创建
# 禁止 Hibernate/JPA 自动建表，也禁止 Spring 自动执行 SQL
# ============================================================
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.sql.init.mode=never

# Thymeleaf 与 MyBatis
spring.thymeleaf.cache=true
mybatis.mapper-locations=classpath:/mapper/*.xml
mybatis.type-aliases-package=com.example.kidsmath
mybatis.configuration.map-underscore-to-camel-case=true

# 项目自检开关；正式分享可保持开启，启动日志会打印数据库状态
app.phase0.db-smoke-test-enabled=true

# 日志级别
logging.level.root=INFO
logging.level.com.example.kidsmath=INFO
